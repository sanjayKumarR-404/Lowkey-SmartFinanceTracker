# Environment Variables — Lowkey Smart Finance Tracker
# Copy this file to .env in the repo root and fill in your real values.
# NEVER commit the real .env file to git.

# Port the Express server will listen on
PORT=5000

# MongoDB connection string (get this from MongoDB Atlas or your local MongoDB)
MONGO_URI=your_mongodb_connection_string_here

# Secret key used to sign JWT tokens — make this a long random string
JWT_SECRET=your_jwt_secret_key_here

# How long a JWT token stays valid before the user must log in again
JWT_EXPIRES_IN=7d

# Set to "development" locally and "production" on the live server
NODE_ENV=development
